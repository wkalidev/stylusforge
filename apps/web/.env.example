# Web app environment variables (names only, never commit values).
#
# - apps/web/.env.local: your own values (WalletConnect id, testnet settings).
# - apps/web/.env.development.local: written by `pnpm deploy:local` for the
#   local Hardhat chain; loaded by `next dev` only and takes precedence there.

# WalletConnect Cloud project id used by RainbowKit (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_ID=
# Chain id: 31337 for the local Hardhat node, 421614 (default) for Arbitrum Sepolia
NEXT_PUBLIC_CHAIN_ID=
# Address of the deployed StylusForgeNFT contract on that chain
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
# Private key of the claim signer (server only: read by the claim API route, never exposed to the browser)
CLAIM_SIGNER_PRIVATE_KEY=
