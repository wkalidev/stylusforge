# Hardhat configuration variables (names only, never commit values).
# Hardhat 3 does not load .env files: store these in the encrypted keystore
# (`pnpm hardhat keystore set <NAME>`) or export them in your shell.

# Arbitrum Sepolia JSON-RPC endpoint
ARBITRUM_SEPOLIA_RPC_URL=
# Private key of the deployer account (0x-prefixed)
DEPLOYER_PRIVATE_KEY=
# Public address of the backend key that signs claim vouchers (used by scripts/deploy.ts)
CLAIM_SIGNER_ADDRESS=
# Etherscan API V2 key, used by `hardhat verify` to verify on Arbiscan (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
# Used by scripts/set-uri.ts after the web app is deployed
# Address of the deployed StylusForgeNFT contract
NFT_CONTRACT_ADDRESS=
# Base URL of the deployed web app (https), e.g. https://stylusforge.example
METADATA_BASE_URL=
